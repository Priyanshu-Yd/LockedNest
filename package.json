{
  "name": "vaultbrowse",
  "productName": "SafeNest",
  "version": "1.0.0",
  "description": "SafeNest — your private digital workspace on any PC. Browser, files, and protected Nest spaces behind a local password.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "test:phase1": "electron scripts/phase1-smoke.js",
    "test:phase3": "electron scripts/phase3-smoke.js",
    "test:features": "electron scripts/features-smoke.js",
    "test:personal": "electron scripts/personal-smoke.js",
    "test:personal:m2": "electron scripts/personal-m2-smoke.js",
    "test:personal:m3": "electron scripts/personal-m3-smoke.js",
    "test:personal:m4": "electron scripts/personal-m4-smoke.js",
    "test:security": "electron scripts/security-smoke.js",
    "test:security:path": "electron scripts/security-path-tests.js",
    "test:security:ipc": "electron scripts/security-ipc-tests.js",
    "test:security:lock": "electron scripts/security-lock-tests.js",
    "test:security:vault": "electron scripts/security-vaultprivate-tests.js",
    "test:security:closure": "electron scripts/security-closure-tests.js"
  },
  "author": "SafeNest",
  "license": "MIT",
  "build": {
    "appId": "com.safenest.app",
    "productName": "SafeNest",
    "copyright": "Copyright © SafeNest",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SafeNest"
    },
    "portable": {
      "artifactName": "SafeNest-Portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26"
  }
}
